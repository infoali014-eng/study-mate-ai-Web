# ==============================================================================
# DEEPCODE PRODUCTION ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# 1. Base Application Domain
NEXT_PUBLIC_APP_URL=https://deepcode.study

# 2. Supabase Authentication & PostgreSQL Database
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here

# 4. API Gateway Configuration
NEXT_PUBLIC_API_URL=https://deepcode.study
